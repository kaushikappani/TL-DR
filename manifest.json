{
  "manifest_version": 3,
  "name": "TL;DR",
  "version": "1.0.0",
  "description": "Summarize any web page or article and ask follow-up questions about it, powered by Google Gemini.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "lib/pdf.worker.min.mjs"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
